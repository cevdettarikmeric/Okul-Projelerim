<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <EditText
        android:id="@+id/et1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="77dp"
        android:layout_marginTop="29dp"
        android:ems="10"
        android:hint="1.Sınav Notu"
        android:inputType="number"
        android:scrollbarSize="20dp"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/et2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="1dp"
        android:layout_marginTop="15dp"
        android:ems="10"
        android:hint="2.Sınav Notu"
        android:inputType="number"
        android:scrollbarSize="20dp"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="@+id/et1"
        app:layout_constraintTop_toBottomOf="@+id/et1" />

    <Button
        android:id="@+id/b1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="53dp"
        android:layout_marginBottom="23dp"
        android:text="Hesapla"
        android:textSize="20sp"
        app:layout_constraintBottom_toTopOf="@+id/ort"
        app:layout_constraintStart_toStartOf="@+id/et2" />

    <TextView
        android:id="@+id/ort"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="242dp"
        android:layout_marginEnd="11dp"
        android:text="Ortalama : "
        android:textSize="34sp"
        app:layout_constraintEnd_toEndOf="@+id/b1"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/gecme"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="50dp"
        android:layout_marginTop="8dp"
        android:text="Geçme Durumu :"
        android:textSize="34sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ort" />

</androidx.constraintlayout.widget.ConstraintLayout>